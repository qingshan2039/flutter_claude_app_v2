{
  "@@locale": "en",

  "appTitle": "Flutter Claude App",
  "@appTitle": {
    "description": "Application title shown in the app bar and task switcher"
  },

  "ok": "OK",
  "cancel": "Cancel",
  "confirm": "Confirm",
  "save": "Save",
  "delete": "Delete",
  "edit": "Edit",
  "retry": "Retry",
  "close": "Close",
  "back": "Back",

  "navHome": "Home",
  "navSearch": "Search",
  "navSettings": "Settings",
  "login": "Sign in",
  "logout": "Sign out",

  "loading": "Loading…",
  "emptyTitle": "Nothing here yet",
  "emptyMessage": "There's no content to display.",
  "successMessage": "Done!",

  "errorNetwork": "Network error. Please check your connection.",
  "errorServer": "Something went wrong on our end. Please try again.",
  "errorUnauthorized": "Your session has expired. Please sign in again.",
  "errorValidation": "Please check your input and try again.",
  "errorUnknown": "An unexpected error occurred.",

  "languageEnglish": "English",
  "languageChinese": "简体中文",
  "languageFollowSystem": "Follow system",
  "settingsLanguage": "Language",

  "greetingNamed": "Hello, {name}!",
  "@greetingNamed": {
    "description": "Personalized greeting with a placeholder",
    "placeholders": {
      "name": { "type": "String", "example": "Alice" }
    }
  },

  "itemCount": "{count, plural, =0{No items} =1{1 item} other{{count} items}}",
  "@itemCount": {
    "description": "Pluralized count of items",
    "placeholders": {
      "count": { "type": "int", "example": "3" }
    }
  },

  "unreadMessages": "{count, plural, =0{No unread messages} =1{You have 1 unread message} other{You have {count} unread messages}}",
  "@unreadMessages": {
    "description": "Pluralized unread message banner",
    "placeholders": {
      "count": { "type": "int", "example": "5" }
    }
  },

  "lastUpdated": "Last updated: {date}",
  "@lastUpdated": {
    "description": "A formatted date using intl DateFormat",
    "placeholders": {
      "date": { "type": "DateTime", "format": "yMMMd", "example": "May 18, 2026" }
    }
  },

  "priceLabel": "Price: {amount}",
  "@priceLabel": {
    "description": "A currency-formatted number",
    "placeholders": {
      "amount": {
        "type": "double",
        "format": "currency",
        "optionalParameters": { "symbol": "$", "decimalDigits": 2 },
        "example": "19.99"
      }
    }
  },

  "completionRate": "Completion: {value}",
  "@completionRate": {
    "description": "A percent-formatted number",
    "placeholders": {
      "value": {
        "type": "double",
        "format": "percentPattern",
        "example": "0.87"
      }
    }
  }
}
