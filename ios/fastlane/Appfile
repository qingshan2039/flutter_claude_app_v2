# M16/T16.5 fastlane Appfile —— 上线前填入真实值（team_id/apple_id 可入库；
# 凭据/密钥务必走环境变量或 CI Secrets，勿写在此）。
app_identifier("com.ben.claudeFlutterV2.flutterClaudeAppV2") # prod bundle id
apple_id(ENV["FASTLANE_APPLE_ID"] || "you@example.com")
itc_team_id(ENV["ASC_TEAM_ID"] || "")  # App Store Connect team id
team_id(ENV["DEVELOPER_TEAM_ID"] || "") # Developer Portal team id
